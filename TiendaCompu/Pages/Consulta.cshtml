@page
@model TiendaCompu.Pages.ConsultaModel
@{
    ViewData["Title"] = "Consulta de Productos";
}

<div class="text-center mb-4">
    <h2>Catálogo de Componentes</h2>
    <p>Listado completo de productos disponibles en TiendaCompu.</p>
</div>

<table class="table table-dark table-bordered table-striped mt-4">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre del Componente</th>
            <th>Precio ($)</th>
            <th>Categoría</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model.ListaProductos)
        {
            <tr>
                <td>@producto.Id</td>
                <td>@producto.Nombre</td>
                <td>@producto.Precio</td>
                <td>@producto.Categoria</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-page="/Index" class="btn btn-outline-secondary">Volver a la página principal</a>
</div>