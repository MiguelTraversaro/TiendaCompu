@page
@model TiendaCompu.Pages.ModificacionModel
@{
    ViewData["Title"] = "Modificar Productos";
}

<div class="text-center mb-4 mt-4">
    <h2>Modificar Componentes</h2>
    <p>Haga clic en 'Editar' en la fila del producto que desea modificar.</p>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alert alert-success">@Model.MensajeExito</div>
}
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger">@Model.MensajeError</div>
}

<!-- se envuelve la tabla entera en un formulario -->
<form method="post">
    <table class="table table-dark table-bordered table-striped mt-4">
        <thead class="table-dark" style="border-bottom: 2px solid #00c3ff;">
            <tr>
                <th>ID</th>
                <th>Nombre del Componente</th>
                <th>Precio ($)</th>
                <th>Categoría</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prod in Model.ListaProductos)
            {
                @if (Model.IdEditando == prod.Id)
                {
                    <tr class="table-active">
                        <td class="align-middle">
                            @prod.Id
                            <input type="hidden" name="idProducto" value="@prod.Id" />
                            <input type="hidden" name="nombreOriginal" value="@prod.Nombre" />
                            <input type="hidden" name="precioOriginal" value="@prod.Precio" />
                            <input type="hidden" name="idCategoriaOriginal" value="@prod.IdCategoria" />
                        </td>
                        <td>
                            <input type="text" name="nombre" value="@prod.Nombre" class="form-control" required />
                        </td>
                        <td>
                            <input type="text" name="precio" value="@prod.Precio" class="form-control" required />
                        </td>
                        <td>
                            <select name="idCategoria" class="form-select" required>
                                <!-- operador ternario para dejar seleccionada la categoría original -->
                                <option value="1" selected="@(prod.IdCategoria == 1 ? "selected" : null)">Procesador</option>
                                <option value="2" selected="@(prod.IdCategoria == 2 ? "selected" : null)">Placa de video</option>
                                <option value="3" selected="@(prod.IdCategoria == 3 ? "selected" : null)">Memoria</option>
                                <option value="4" selected="@(prod.IdCategoria == 4 ? "selected" : null)">Motherboard</option>
                                <option value="5" selected="@(prod.IdCategoria == 5 ? "selected" : null)">Almacenamiento</option>
                            </select>
                        </td>
                        <td class="align-middle">
                            <button type="submit" asp-page-handler="Guardar" class="btn btn-warning btn-sm fw-bold">Guardar</button>
                            <button type="submit" asp-page-handler="Cancelar" class="btn btn-secondary btn-sm" formnovalidate>Cancelar</button>
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td class="align-middle">@prod.Id</td>
                        <td class="align-middle">@prod.Nombre</td>
                        <td class="align-middle">@prod.Precio</td>
                        <td class="align-middle">@prod.CategoriaDesc</td>
                        <td class="align-middle">
                            <!-- enviar el ID de esta fila al método Editar -->
                            <button type="submit" asp-page-handler="Editar" asp-route-idProducto="@prod.Id" class="btn btn-outline-info btn-sm">Editar</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</form>

<div class="mt-3 text-center mb-5">
    <a asp-page="/Index" class="btn btn-outline-secondary">Volver al Inicio</a>
</div>